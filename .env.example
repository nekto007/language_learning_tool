# ── Required ──────────────────────────────────────────────
# These must be set; app will refuse to start without them.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=language_learning
POSTGRES_HOST=db
POSTGRES_PORT=5432
SECRET_KEY=your-secret-key-change-this
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ── Security ──────────────────────────────────────────────
# JWT_SECRET_KEY must be set in production; in dev a random key is generated per restart.
JWT_SECRET_KEY=your-jwt-secret-key-here

# ── Recommended ───────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
# FLASK_ENV values: development | production
# development: insecure cookies, random JWT fallback
# production : secure cookies, JWT_SECRET_KEY required

# ── Optional integrations ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=llt_englishbot
# Set TELEGRAM_POLLING=true to run bot in polling mode (development only)
TELEGRAM_POLLING=

# Disputed answers use the existing Telegram bot and linked administrator accounts.
OPENAI_API_KEY=
OPENAI_MODEL=

SITE_URL=https://example.com

GOOGLE_SITE_VERIFICATION=
GOOGLE_ANALYTICS_ID=
# Empty disables Metrica. Only llt-english.com is tracked; never local or learn.*.
YANDEX_METRIKA_ID=114597985

# ── Email (reminders / notifications) ────────────────────
# Leave blank to disable email sending.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
# SMTP_DEBUG_LEVEL: 0=off, 1=commands, 2=verbose
SMTP_DEBUG_LEVEL=0

# Optional dedicated provider for verification/reset codes.
# Empty AUTH_EMAIL_HOST preserves the existing EMAIL_* transport as a whole.
# If set, the other AUTH_EMAIL_* transport settings do NOT inherit EMAIL_*.
# Use port 587 + TLS, or port 465 + SSL (never both).
AUTH_EMAIL_HOST=
AUTH_EMAIL_PORT=587
AUTH_EMAIL_HOST_USER=
AUTH_EMAIL_HOST_PASSWORD=
AUTH_EMAIL_USE_TLS=True
AUTH_EMAIL_USE_SSL=False
AUTH_DEFAULT_FROM_EMAIL=
# Set false when running the dedicated auth-mail-worker container.
MOBILE_AUTH_BACKGROUND_MAIL=True

# ── Rate limiting ─────────────────────────────────────────
# Storage backend for Flask-Limiter. "memory://" is fine for single-process dev;
# use "redis://localhost:6379/0" for multi-worker production.
RATELIMIT_STORAGE_URI=memory://

# ── Tuning ────────────────────────────────────────────────
REQUEST_TIMEOUT=10
MAX_RETRIES=3
MAX_PAGES=100

# Default timezone used as fallback when user has no timezone set.
DEFAULT_TIMEZONE=Europe/Moscow

# Queries slower than this threshold (ms) are logged as slow queries.
SLOW_QUERY_MS=100

# ── Google Search Console (optional, /admin/seo integration) ──
# OAuth2 client credentials from https://console.cloud.google.com/.
# Required only if you want the GSC card on /admin/seo to render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LanguageTool (грамматическая проверка письма) ─────────
# В docker-compose web получает http://languagetool:8010 по умолчанию.
# Для локальной разработки: docker run -d -p 8010:8010 erikvl87/languagetool
# и LANGUAGETOOL_URL=http://localhost:8010. Пусто = проверка выключена.
LANGUAGETOOL_URL=

# ── Anthropic (только для контентных скриптов) ────────────
# Нужен исключительно scripts/generate_reading_annotations.py.
# Пакет `anthropic` намеренно не в requirements.txt: pip install anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-5

# ── Testing (only for test runner) ────────────────────────
# TESTING=true
# DATABASE_URL=postgresql://user:password@localhost:5432/language_learning_test

# ── Native iOS sign-in (separate from Search Console) ─────
# Configure SMTP above for native email confirmation and password reset.
MOBILE_GOOGLE_CLIENT_ID=
MOBILE_GOOGLE_CLIENT_SECRET=
MOBILE_GOOGLE_REDIRECT_URI=https://llt-english.com/api/mobile/auth/google/callback
MOBILE_APPLE_ENABLED=false
MOBILE_APPLE_CLIENT_ID=com.llt.english.ios
MOBILE_APPLE_TEAM_ID=
MOBILE_APPLE_KEY_ID=
# P8 PEM contents with literal \n separators, on the server only.
MOBILE_APPLE_PRIVATE_KEY=

# Native iOS reminders via APNs (server only; P8 PEM with literal \n separators).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.llt.english.ios
